# Copy to .env for local development. Values below are disposable local credentials only.
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

POSTGRES_DB=assetforge
POSTGRES_USER=assetforge
POSTGRES_PASSWORD=assetforge_local_only
DATABASE_URL=postgresql://assetforge:assetforge_local_only@localhost:5432/assetforge?schema=public

REDIS_URL=redis://localhost:6379

MINIO_ROOT_USER=assetforge
MINIO_ROOT_PASSWORD=assetforge_local_only_change_me
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=assetforge
STORAGE_SECRET_KEY=assetforge_local_only_change_me
STORAGE_BUCKET=assetforge-assets

# Replace with a randomly generated secret before running authenticated features.
JWT_SECRET=local-placeholder-change-before-use-0000000000000000
SESSION_SECRET=local-placeholder-change-before-use-0000000000000000
