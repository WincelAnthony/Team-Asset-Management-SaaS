{
  "name": "assetforge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @assetforge/config build && pnpm --parallel --filter @assetforge/web --filter @assetforge/api --filter @assetforge/worker dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --filter @assetforge/config build && pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm build"
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
